#!/usr/bin/env bash
# Snapshot the two live shell deploy targets into a timestamped zstd tarball so
# any consolidation phase is one-command revertible (see ryoku-shell-rollback).
# Operates on files only; never touches the running shell.
set -euo pipefail

backup_dir="${XDG_STATE_HOME:-$HOME/.local/state}/ryoku/shell-backups"
# stored relative to $HOME so rollback can extract with -C "$HOME"
targets=(".config/quickshell" ".local/lib/qt6/qml/Ryoku")
keep=10

mkdir -p "$backup_dir"

present=()
for t in "${targets[@]}"; do
  [[ -e "$HOME/$t" ]] && present+=("$t")
done
if (( ${#present[@]} == 0 )); then
  echo "ryoku-shell-snapshot: no deploy targets present to snapshot" >&2
  exit 1
fi

# ISO 8601 basic (colon-free) keeps the name shell- and tar-friendly.
ts=$(date -u +%Y%m%dT%H%M%SZ)
archive="$backup_dir/$ts.tar.zst"

tar --zstd -cf "$archive" -C "$HOME" "${present[@]}"

# Prune to the newest $keep archives.
mapfile -t all < <(find "$backup_dir" -maxdepth 1 -name '*.tar.zst' -printf '%f\n' | sort -r)
if (( ${#all[@]} > keep )); then
  for old in "${all[@]:keep}"; do
    rm -f -- "$backup_dir/$old"
  done
fi

echo "$archive"
