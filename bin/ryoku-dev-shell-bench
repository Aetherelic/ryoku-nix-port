#!/usr/bin/env bash
# Capture a comparable snapshot of shell performance (RSS, process divisions,
# launch latency, idle CPU) to docs/plans/perf/shell-<label>.txt. One script both
# the before and after runs use, so the numbers line up field for field.
#
#   ryoku-dev-shell-bench <label> [outfile]
set -euo pipefail

label="${1:-}"
if [[ -z "$label" ]]; then
  echo "usage: ryoku-dev-shell-bench <label> [outfile]" >&2
  exit 2
fi
ROOT=${RYOKU_PATH:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
outfile="${2:-$ROOT/docs/plans/perf/shell-$label.txt}"
mkdir -p "$(dirname "$outfile")"

: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export XDG_RUNTIME_DIR

clk=$(getconf CLK_TCK)

# The full resident shell process set: qs surfaces + the daemon + its helpers.
match='qs -c|qs -p|ryoku-shell|wl-paste.*ryoku'
mapfile -t pids < <(pgrep -f "$match" | sort -n)

cmd_of() { tr '\0' ' ' <"/proc/$1/cmdline" 2>/dev/null | sed -E 's/ +$//'; }
# Label = the command line minus argv[0], mirroring shell-before.txt.
label_of() { cmd_of "$1" | cut -d' ' -f2-; }
rss_kb_of() { awk '/^VmRSS:/ { print $2 }' "/proc/$1/status" 2>/dev/null; }
comm_of() { cat "/proc/$1/comm" 2>/dev/null; }
# utime + stime in jiffies (fields 14, 15 after the possibly-spaced comm).
jiffies_of() {
  awk '{ s=$0; sub(/^[^)]*\) /,"",s); n=split(s,f," "); print f[12]+f[13] }' \
    "/proc/$1/stat" 2>/dev/null
}

ms_of() {
  local start end
  start=$(date +%s%N)
  "$@" >/dev/null 2>&1 || true
  end=$(date +%s%N)
  echo $(( (end - start) / 1000000 ))
}

count_match() {
  pgrep -f "$1" 2>/dev/null | wc -l
}

{
  printf '# Ryoku shell performance snapshot (%s) - %s\n' \
    "$label" "$(date --iso-8601=seconds)"
  printf '# %s | %s\n' "$(uname -sr)" \
    "$(pacman -Q qt6-base quickshell 2>/dev/null | tr '\n' ' ' | sed -E 's/ +$//')"
  printf '\n'

  printf '== resident RSS of shell processes ==\n'
  total_mb=0
  nproc_seen=0
  for pid in "${pids[@]}"; do
    kb=$(rss_kb_of "$pid")
    [[ -z "$kb" ]] && continue
    mb=$(awk -v k="$kb" 'BEGIN { printf "%.1f", k/1024 }')
    printf '%9.1f MB  %s\n' "$mb" "$(label_of "$pid")"
    total_mb=$(awk -v t="$total_mb" -v m="$mb" 'BEGIN { printf "%.4f", t+m }')
    nproc_seen=$((nproc_seen + 1))
  done
  printf '  TOTAL: %.0f MB across %d procs (only currently-resident surfaces)\n' \
    "$total_mb" "$nproc_seen"
  printf '\n'

  printf '== process divisions ==\n'
  printf '  %-20s : %d\n' "qs surface processes" "$(count_match 'qs -c|qs -p')"
  printf '  %-20s : %d\n' "ryoku-shell (all)" "$(count_match 'ryoku-shell')"
  printf '  %-20s : %d\n' "clip-ingest leaked" "$(count_match '__clip-ingest')"
  printf '\n'

  printf '== launch trigger latencies ==\n'
  for _ in 1 2 3; do
    printf '  ryoku-shell client roundtrip: %d ms\n' "$(ms_of ryoku-shell status)"
  done
  printf '  qs Qt init floor (each ipc-call spawn): %d ms\n' "$(ms_of qs --help)"
  printf '\n'

  printf '== idle CPU over 2s ==\n'
  # Sample the resident surfaces + daemon only (skip leaked clip-ingest helpers).
  resident=()
  for pid in "${pids[@]}"; do
    c=$(cmd_of "$pid")
    case "$c" in
      *"qs -c"*|*"qs -p"*|*"ryoku-shell daemon") resident+=("$pid") ;;
    esac
  done
  declare -A j0
  for pid in "${resident[@]}"; do
    j0[$pid]=$(jiffies_of "$pid")
  done
  sleep 2
  for pid in "${resident[@]}"; do
    j1=$(jiffies_of "$pid")
    [[ -z "$j1" || -z "${j0[$pid]:-}" ]] && continue
    pct=$(awk -v d="$((j1 - ${j0[$pid]}))" -v c="$clk" \
      'BEGIN { printf "%.1f", (d / c) / 2.0 * 100 }')
    printf '%7.1f%% CPU  %s (pid %d)\n' "$pct" "$(comm_of "$pid")" "$pid"
  done
} >"$outfile"

cat "$outfile"
