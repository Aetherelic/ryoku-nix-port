# Maintainer: Ryoku
#
# spicetify-marketplace = the "store" the desktop wires into Spotify: the
# Marketplace icon in Spotify's left sidebar that installs themes and extensions.
# Spotify (spotify-launcher) and spicetify-cli already ship (see base.packages);
# this is the store's app shell, and `ryoku doctor` (reconcileSpicetifyMarketplace)
# drops it into a Spotify user's spicetify CustomApps, enables it, and applies it,
# so the store is there out of the box instead of the fiddly manual install
# (fetch a release zip, unzip into CustomApps, `spicetify config custom_apps`,
# apply, then hand-make a placeholder theme so theme installs land).
#
# shipped from [ryoku] instead of the AUR for the same reason as spicetify-cli:
# `ryoku update` is pacman and pacman never touches the AUR, so a box that missed
# a one-shot AUR build had no store and no route to one but a manual install.
# As a signed [ryoku] package it is a plain pacman target: it lands on install,
# on `ryoku update`, and in the offline closure. The store's CONTENT
# (themes/extensions) is fetched from the internet when the user browses it --
# that is inherent to a store -- but the app shell ships here so the icon is
# present without a network round-trip at setup, and the doctor patch is offline.
#
# prebuilt upstream artifact: marketplace.zip IS the webpack build (index.js +
# manifest.json + assets), so there is no build(); package() only lays the dist
# under /usr/share/ryoku, from where the doctor reconciler copies it per user (it
# never patches Spotify from a system path, so an update never touches a home).
#
# fixed-version package: it tracks upstream Marketplace releases, not the monorepo
# RYOKU_PKGVER. To follow a new release, bump pkgver, refresh sha256sums, and
# reset pkgrel; bump pkgrel when only this recipe changes. build-repo.sh adopts
# the already-published bytes for an unchanged filename, so a rebuild at the same
# version is a no-op for the signed repo.
pkgname=spicetify-marketplace
pkgver=1.0.9
pkgrel=1
pkgdesc='Spicetify Marketplace: the store custom app for the Spotify client'
arch=('x86_64')
url='https://github.com/spicetify/marketplace'
license=('GPL-3.0-or-later')
# the release zip's only top-level entry is marketplace-dist/; makepkg extracts it
# into $srcdir. the checksum pins the exact upstream bytes for the signed repo.
source=("marketplace-${pkgver}.zip::https://github.com/spicetify/marketplace/releases/download/v${pkgver}/marketplace.zip")
sha256sums=('2713054703c2365e391658a58c782dd2ebdd8d573f2015b5a2bab58b7eee8685')

package() {
  # the store app shell, where reconcileSpicetifyMarketplace copies from into the
  # per-user spicetify CustomApps.
  install -dm755 "${pkgdir}/usr/share/ryoku/spicetify/marketplace"
  cp -a "${srcdir}/marketplace-dist/." "${pkgdir}/usr/share/ryoku/spicetify/marketplace/"
  find "${pkgdir}/usr/share/ryoku/spicetify/marketplace" -type d -exec chmod 755 {} +
  find "${pkgdir}/usr/share/ryoku/spicetify/marketplace" -type f -exec chmod 644 {} +

  # the placeholder theme Marketplace needs before it can install themes. It is
  # transparent -- `[Marketplace]` with no colour keys -- so it enables theme
  # installs without recolouring Spotify (Ryoku does not theme the client; the
  # recolor engine has no spicetify template). The reconciler drops it into the
  # user's Themes/marketplace/color.ini only when no real theme is set.
  printf '[Marketplace]\n' > "${pkgdir}/usr/share/ryoku/spicetify/marketplace-color.ini"
  chmod 644 "${pkgdir}/usr/share/ryoku/spicetify/marketplace-color.ini"
}
