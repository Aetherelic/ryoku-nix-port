# Maintainer: Ryoku <releases@ryoku.dev>
#
# spicetify = what patches the Spotify client so the desktop music widget's
# Spotify Canvas backdrop works. Spotify's Canvas token is bot-gated, so the
# shell daemon cannot fetch it (ryoku/shell/ipc/music.go); the Ryoku Canvas
# extension runs inside the spicetified client, where a valid session token
# exists, and relays the Canvas URL to the daemon's loopback endpoint. Without
# spicetify that backdrop silently never appears, and `ryoku doctor` has a whole
# reconciler whose only job is wiring it up.
#
# shipped from [ryoku] instead of the AUR on purpose, for the same reason as
# awww. The ISO does bake the AUR set (installation/iso/offline-repo.sh
# bake_aur_set) and the build gate fails if a name is missing, so an ISO install
# does get it. What it could NOT reach is an existing machine: `ryoku update` is
# pacman, and pacman never touches the AUR, so a box that installed before this
# package set, or whose one-shot AUR build failed, had no spicetify and no way to
# get one except a manual `yay -S`. Building it here as a signed [ryoku] package
# makes it a plain pacman target: it lands on install, on `ryoku update`, and in
# the offline closure, exactly like ffmpeg.
#
# fixed-version package: it tracks upstream spicetify releases, not the monorepo
# RYOKU_PKGVER. To follow a new release, bump pkgver, refresh sha256sums, and
# reset pkgrel; bump pkgrel when only this recipe changes. build-repo.sh adopts
# the already-published bytes for an unchanged filename, so a rebuild at the same
# pkgver never breaks clients holding the previous db.
#
# pnpm is a real makedepend, not decoration: `build:wrapper` generates
# jsHelper/spicetifyWrapper.js, which is the `Spicetify` global every extension
# (ours included) is written against. It is absent from the release tarball, so a
# build that skipped pnpm would produce a package that looks complete and breaks
# the Canvas extension. The publish-repo build host installs pnpm for this.
pkgname=spicetify-cli
pkgver=2.44.0
pkgrel=3
pkgdesc='Command-line tool to customize Spotify client'
arch=('x86_64')
url='https://github.com/spicetify/cli'
license=('LGPL-2.1-only')
makedepends=('go' 'pnpm')
depends=('glibc' 'bash')
optdepends=('xdg-utils: Allows for opening directories in default file manager')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha256sums=('aafdfceeae5ff926ffe27bf3808cd4228e3a2725f7f3539531f4f5c0ac98962d')

prepare() {
  mv "cli-${pkgver}" "${pkgname}-${pkgver}"
}

build() {
  cd "${pkgname}-${pkgver}"
  export GO111MODULE="auto"
  export GOPATH="${srcdir}"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=readonly -modcacherw"
  go build -ldflags="-X 'main.version=${pkgver}'" -o spicetify

  pnpm install --frozen-lockfile
  pnpm build:wrapper
}

check() {
  cd "${pkgname}-${pkgver}"
  test "v$(./spicetify -v)" = "v${pkgver}" || exit 1

  pnpm check:wrapper
}

package() {
  cd "${pkgname}-${pkgver}"

  # /opt, matching the upstream AUR layout, so a box that switches between the
  # two packages sees the same paths and spicetify's own prefix logic holds.
  install -Dm755 ./spicetify "${pkgdir}/opt/${pkgname}/spicetify"
  cp -r ./CustomApps "${pkgdir}/opt/${pkgname}/CustomApps"
  cp -r ./Extensions "${pkgdir}/opt/${pkgname}/Extensions"
  cp -r ./jsHelper "${pkgdir}/opt/${pkgname}/jsHelper"
  cp -r ./Themes "${pkgdir}/opt/${pkgname}/Themes"

  install -Dm755 ./css-map.json "${pkgdir}/opt/${pkgname}/css-map.json"
  install -Dm755 ./globals.d.ts "${pkgdir}/opt/${pkgname}/globals.d.ts"

  install -dm755 "${pkgdir}/usr/bin"
  printf '#!/bin/sh\nexec /opt/%s/spicetify "$@"\n' "${pkgname}" \
    >"${pkgdir}/usr/bin/spicetify"
  chmod 755 "${pkgdir}/usr/bin/spicetify"

  go clean -modcache
}
