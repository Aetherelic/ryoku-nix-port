#!/usr/bin/env bash
# Ryoku's one door to root for container work, driven by the stash "Cobalt
# engine" switch and its setup wizard.
#
# Why a helper instead of the docker group: adding a user to `docker` does not
# affect the session they are already in, so a group-based design ends its
# first run at a reboot prompt. This helper escalates through pkexec instead
# (47-style polkit rule, active wheel user, no password), so it never consults
# the caller's groups and first-time setup needs no re-login. The group is still
# added by `provision`, because a user who types `docker` on the command line
# wants it, but nothing here depends on it.
#
# SECURITY: the polkit grant is passwordless, so this script must never become a
# way to run arbitrary docker. There is deliberately NO passthrough verb. Every
# container action below is a fixed argument vector with a hardcoded image and
# container name; the only caller-supplied value is a port, range-checked to an
# integer. A `docker run` that accepted caller flags would hand out root via
# `-v /:/host`.
#
# tab-separated, line-buffered output the shell (Stash.qml) parses:
#   state           -> binary/service/group/member/socket, one fact per line
#   provision       -> "STEP\t<service|group|socket>" ... then "OK" or "ERROR\t<msg>"
#   container-*     -> the value, or "ERROR\t<msg>"
# usage: ryoku-docker state | provision | container-status | container-up [port] | container-down
set -uo pipefail

NAME="ryoku-cobalt"
IMAGE="ghcr.io/imputnet/cobalt:11"
DEFAULT_PORT=9000

# Test seams, so the fixture suite can drive fakes rather than a real daemon and
# assert the argument policy without root.
#
# SECURITY: they are honoured ONLY when this is not running privileged. pkexec
# sanitises the environment, so in practice they cannot cross that boundary
# anyway, but relying on that would make an env-passing change elsewhere silently
# catastrophic: RYOKU_DOCKER_BIN reaching a root pass would be arbitrary root
# code execution. Ignoring them at EUID 0 makes the privileged pass depend on
# nothing the caller controls, which is a property this script can guarantee by
# itself rather than borrow from pkexec.
if [[ $EUID -eq 0 ]]; then
  DOCKER=docker
  SYSTEMCTL=systemctl
  SOCKET=/var/run/docker.sock
  GETENT=getent
else
  DOCKER="${RYOKU_DOCKER_BIN:-docker}"
  SYSTEMCTL="${RYOKU_DOCKER_SYSTEMCTL:-systemctl}"
  SOCKET="${RYOKU_DOCKER_SOCKET:-/var/run/docker.sock}"
  GETENT="${RYOKU_DOCKER_GETENT:-getent}"
fi

emit() { printf '%s\t%s\n' "$1" "${2:-}"; }
log() { printf 'ryoku-docker: %s\n' "$*" >&2; }

# The user this ran for. Under pkexec the environment is root's, so PKEXEC_UID
# is the only honest answer; a direct root call falls back to SUDO_UID, and an
# unprivileged call is simply the caller.
caller_name() {
  local uid="${PKEXEC_UID:-${SUDO_UID:-}}"
  if [[ -n $uid ]]; then
    "$GETENT" passwd "$uid" 2>/dev/null | cut -d: -f1
    return
  fi
  id -un
}

have_docker() { command -v "$DOCKER" >/dev/null 2>&1; }

service_state() {
  have_docker || { echo absent; return; }
  if "$SYSTEMCTL" is-active --quiet docker 2>/dev/null; then
    echo active
  else
    echo inactive
  fi
}

group_exists() { "$GETENT" group docker >/dev/null 2>&1; }

# Membership per /etc/group, which is what a NEW login session will see. The
# current session may still be missing it; that is the whole reason this helper
# exists, so report the file rather than `id`.
is_member() {
  local u="$1"
  "$GETENT" group docker 2>/dev/null | awk -F: -v u="$u" '
    { n = split($4, m, ","); for (i = 1; i <= n; i++) if (m[i] == u) { found = 1 } }
    END { exit(found ? 0 : 1) }
  '
}

socket_ready() { [[ -S $SOCKET ]]; }

# Re-exec the whole command under pkexec when the action needs root and we are
# not it. 47-ryoku-docker.rules makes that passwordless for an active wheel user.
need_root() {
  # RYOKU_DOCKER_ASSUME_ROOT is a test seam (same shape as ryoku-hw-laptop's
  # RYOKU_ASSUME_LAPTOP): it lets the fixture exercise the privileged branches
  # against fakes without root. It deliberately does NOT short-circuit the
  # argument checks above, which is where the security assertions live.
  [[ $EUID -eq 0 || -n ${RYOKU_DOCKER_ASSUME_ROOT:-} ]] && return 0
  command -v pkexec >/dev/null 2>&1 || {
    emit ERROR "needs root and pkexec is not available"
    exit 1
  }
  exec pkexec "$(readlink -f "${BASH_SOURCE[0]}")" "${ORIG_ARGV[@]}"
}

ORIG_ARGV=("$@")
cmd="${1:-}"

case "$cmd" in
state)
  # Read-only: never escalates, so the wizard can poll it freely.
  u="$(caller_name)"
  emit binary "$(have_docker && echo yes || echo no)"
  emit service "$(service_state)"
  emit group "$(group_exists && echo yes || echo no)"
  emit member "$(is_member "$u" && echo yes || echo no)"
  emit socket "$(socket_ready && echo yes || echo no)"
  ;;
provision)
  have_docker || { emit ERROR "docker is not installed"; exit 2; }
  u="$(caller_name)"
  [[ -n $u ]] || { emit ERROR "could not resolve the invoking user"; exit 1; }

  # Convergent: a host that is already provisioned writes nothing and, because
  # the checks run before need_root, never even raises a pkexec prompt.
  if [[ "$(service_state)" == active ]] && group_exists && is_member "$u" && socket_ready; then
    emit OK
    exit 0
  fi
  need_root

  if [[ "$(service_state)" != active ]]; then
    emit STEP service
    "$SYSTEMCTL" enable --now docker >/dev/null 2>&1 || {
      emit ERROR "could not enable docker.service"
      exit 1
    }
  fi

  if ! group_exists; then
    emit STEP group
    groupadd -r docker >/dev/null 2>&1 || {
      emit ERROR "could not create the docker group"
      exit 1
    }
  fi
  if ! is_member "$u"; then
    emit STEP group
    gpasswd -a "$u" docker >/dev/null 2>&1 || {
      emit ERROR "could not add $u to the docker group"
      exit 1
    }
  fi

  # The unit can report active before the socket is bound; a container action
  # that raced it would fail for no reason the user could act on.
  if ! socket_ready; then
    emit STEP socket
    for _ in $(seq 1 50); do
      socket_ready && break
      sleep 0.2
    done
  fi
  socket_ready || { emit ERROR "docker.service started but its socket never appeared"; exit 1; }
  emit OK
  ;;
container-status)
  have_docker || { emit ERROR "docker is not installed"; exit 2; }
  need_root
  if st="$("$DOCKER" inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)"; then
    [[ $st == true ]] && echo running || echo stopped
  else
    echo absent
  fi
  ;;
container-up)
  have_docker || { emit ERROR "docker is not installed"; exit 2; }
  port="${2:-$DEFAULT_PORT}"
  # The one caller-supplied value in this script. Unprivileged ports are refused
  # as well as non-numbers, so this cannot bind something privileged either.
  if ! [[ $port =~ ^[0-9]+$ ]] || (( port < 1024 || port > 65535 )); then
    emit ERROR "port must be an integer 1024-65535"
    exit 2
  fi
  need_root
  if st="$("$DOCKER" inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)"; then
    [[ $st == true ]] && { emit OK; exit 0; }
    "$DOCKER" start "$NAME" >/dev/null 2>&1 || { emit ERROR "could not start the cobalt container"; exit 1; }
    emit OK
    exit 0
  fi
  # First run. The image and every flag are fixed here on purpose; see SECURITY.
  "$DOCKER" image inspect "$IMAGE" >/dev/null 2>&1 || emit STEP pulling
  if ! "$DOCKER" run -d --name "$NAME" --restart unless-stopped \
      -p "127.0.0.1:${port}:9000" -e "API_URL=http://localhost:${port}/" \
      "$IMAGE" >/dev/null 2>&1; then
    emit ERROR "could not start cobalt (is port ${port} free?)"
    exit 1
  fi
  emit OK
  ;;
container-down)
  have_docker || { emit OK; exit 0; }
  need_root
  if st="$("$DOCKER" inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)"; then
    if [[ $st == true ]]; then
      "$DOCKER" stop "$NAME" >/dev/null 2>&1 || { emit ERROR "could not stop the cobalt container"; exit 1; }
    fi
  fi
  emit OK
  ;;
*)
  echo "usage: ryoku-docker state | provision | container-status | container-up [port] | container-down" >&2
  exit 2
  ;;
esac
