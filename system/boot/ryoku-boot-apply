#!/usr/bin/env bash
# Match the running system to the shipped Ryoku boot look: set the Plymouth
# splash default, sync the Limine branding onto the ESP, and rebuild the
# initramfs (hash-gated). Run by the ryoku-desktop scriptlet on upgrade; skips
# the install chroot, where the installer owns the boot chain.
set -uo pipefail

theme_dir=/usr/share/plymouth/themes/ryoku
boot_src=/usr/share/ryoku/boot
esp=/boot
state_dir=/var/lib/ryoku
stamp=$state_dir/boot-theme.stamp

[ -d "$theme_dir" ] || exit 0
[ -d /run/systemd/system ] || exit 0
[ "$(id -u)" -eq 0 ] || { echo "ryoku-boot-apply: must run as root" >&2; exit 0; }
mkdir -p "$state_dir" 2>/dev/null || true

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  plymouth-set-default-theme ryoku >/dev/null 2>&1 || true
fi

# no wallpaper art: drop any file an older version left on the ESP.
rm -f "$esp/ryoku-wall.png" 2>/dev/null || true

# sync only the visual globals from the shipped template; default_entry, timeout
# and the generated kernel/snapshot entries stay with limine's own tools.
sync_limine_globals() {
  local tmpl=$boot_src/limine.conf conf=$esp/limine.conf tmp canon k
  [ -f "$tmpl" ] && [ -f "$conf" ] || return 0
  tmp=$(mktemp) || return 0
  cp "$conf" "$tmp" || { rm -f "$tmp"; return 0; }
  for k in interface_branding interface_branding_color interface_help_color \
    hash_mismatch_panic term_background backdrop term_palette \
    term_palette_bright term_foreground term_foreground_bright \
    term_background_bright; do
    canon=$(grep -m1 "^$k:" "$tmpl") || continue
    [ -n "$canon" ] || continue
    if grep -q "^$k:" "$tmp"; then
      sed -i "s|^$k:.*|$canon|" "$tmp"
    else
      awk -v line="$canon" '!ins && /^\//{print line; ins=1} {print} END{if(!ins)print line}' \
        "$tmp" >"$tmp.2" && mv "$tmp.2" "$tmp"
    fi
  done
  sed -i '/^wallpaper:/d' "$tmp"
  if ! cmp -s "$tmp" "$conf"; then
    cp -f "$conf" "$conf.ryoku-bak" 2>/dev/null || true
    cat "$tmp" >"$conf" || true
  fi
  rm -f "$tmp" "$tmp.2" 2>/dev/null || true
}
need_rebuild=0
sync_limine_globals

# Sync the fixed kernel-cmdline suffix (the boot-look flags: quiet splash plus
# the log/status silencers that keep systemd/udev/kernel text off the splash)
# from the shipped template onto /etc/default/limine. Only that one suffix line
# is touched; the machine's real root cmdline sits on its own KERNEL_CMDLINE
# line and is never read here. A change forces the UKI rebuild below so it
# reaches the next boot.
sync_limine_cmdline() {
  local tmpl=$boot_src/default.conf conf=/etc/default/limine canon
  local prefix='KERNEL_CMDLINE[default]+=" quiet splash'
  [ -f "$tmpl" ] && [ -f "$conf" ] || return 0
  canon=$(grep -F "$prefix" "$tmpl" | head -n1) || return 0
  [ -n "$canon" ] || return 0
  grep -qF "$prefix" "$conf" || return 0
  grep -qxF "$canon" "$conf" && return 0
  awk -v new="$canon" -v p="$prefix" 'index($0,p)==1{print new;next}{print}' \
    "$conf" >"$conf.ryoku-tmp" && mv "$conf.ryoku-tmp" "$conf" && need_rebuild=1
}
sync_limine_cmdline

# rebuild when the splash content or the cmdline changed; the plymouth mkinitcpio
# hook embeds whatever theme is default and the UKI bakes in the cmdline.
fp=$(find "$theme_dir" -type f -exec sha256sum {} + | sort | sha256sum | cut -d' ' -f1)
if [ "$need_rebuild" -eq 1 ] || [ ! -f "$stamp" ] || [ "$(cat "$stamp" 2>/dev/null)" != "$fp" ]; then
  if command -v limine-mkinitcpio >/dev/null 2>&1; then
    limine-mkinitcpio || true
  elif command -v mkinitcpio >/dev/null 2>&1; then
    mkinitcpio -P || true
  fi
  printf '%s\n' "$fp" >"$stamp" 2>/dev/null || true
fi

exit 0
