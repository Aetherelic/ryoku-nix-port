# Ryoku Plymouth splash.
#
# One crisp centred morph: the 力 seal flows into the RYOKU wordmark once, then
# holds on the finished mark until the display manager takes over (near-black,
# no flash). Plymouth paints the near-black background; the morph layer is only
# downscaled (never upscaled), so the mark stays sharp on any resolution.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

sw = Window.GetWidth();
sh = Window.GetHeight();

# ---- morph layer (centred, downscale-only, play once then hold) ----
