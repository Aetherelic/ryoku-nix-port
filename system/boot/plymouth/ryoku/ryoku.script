# Ryoku Plymouth splash: the installer's block "RYOKU" in live monospace text,
# orange->gold gradient. No frame sequence, so early boot and shutdown stay cheap.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

sw = Window.GetWidth();
sh = Window.GetHeight();

ref = Image.Text("█", 1, 1, 1, 1, "monospace bold 40");
cw = ref.GetWidth();
rh = ref.GetHeight();
COLS = 29;
ROWS = 5;
bx = sw / 2 - (COLS * cw) / 2;
by = sh / 2 - (ROWS * rh) / 2 - rh * 2;

# block cells (reused installer wordmark), coloured along the gradient by column
