# tagline
tag.img = Image.Text("for the sake of power and beauty", 0.42, 0.40, 0.36, 1, "monospace 18");
tag.y = by + ROWS * rh + rh;
tag.sprite = Sprite(tag.img);
tag.sprite.SetPosition(sw / 2 - tag.img.GetWidth() / 2, tag.y, 1);

# ascii spinner: the one moving part, cheap to swap
sp[0] = Image.Text("|", 0.949, 0.337, 0.137, 1, "monospace bold 28");
sp[1] = Image.Text("/", 0.949, 0.337, 0.137, 1, "monospace bold 28");
sp[2] = Image.Text("-", 0.949, 0.337, 0.137, 1, "monospace bold 28");
sp[3] = Image.Text("\\", 0.949, 0.337, 0.137, 1, "monospace bold 28");
global.SPN = 4;
spin.y = tag.y + tag.img.GetHeight() + rh;
spin.sprite = Sprite(sp[0]);
spin.sprite.SetPosition(sw / 2 - sp[0].GetWidth() / 2, spin.y, 2);
global.st = 0;
global.si = 0;

fun refresh_callback ()
  {
    global.st++;
    if (global.st >= 6)
      {
        global.st = 0;
        global.si++;
        if (global.si >= global.SPN)
          global.si = 0;
        spin.sprite.SetImage(sp[global.si]);
      }
  }
Plymouth.SetRefreshFunction (refresh_callback);

# LUKS unlock dialog
lock.image = Image("lock.png");
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");
entry.sprite = Sprite(entry.image);
entry.x = sw / 2 - entry.image.GetWidth() / 2;
entry.y = spin.y + rh * 2;
entry.sprite.SetPosition(entry.x, entry.y, 10001);
entry.sprite.SetOpacity(0);
lh = entry.image.GetHeight() * 0.8;
lw = 84 * (lh / 96);
lock.sprite = Sprite(lock.image.Scale(lw, lh));
lock.sprite.SetPosition(entry.x - lw - 16, entry.y + entry.image.GetHeight() / 2 - lh / 2, 10001);
lock.sprite.SetOpacity(0);
bullet.sprites = [];
fun hide_dialog ()
  {
    lock.sprite.SetOpacity(0);
    entry.sprite.SetOpacity(0);
    for (b = 0; bullet.sprites[b]; b++)
      bullet.sprites[b].SetOpacity(0);
  }
fun display_normal_callback () { hide_dialog(); }
fun display_password_callback (prompt, bullets)
  {
    lock.sprite.SetOpacity(1);
    entry.sprite.SetOpacity(1);
    for (b = 0; bullet.sprites[b]; b++)
      bullet.sprites[b].SetOpacity(0);
    n = bullets;
    if (n > 21)
      n = 21;
    for (b = 0; b < n; b++)
      {
        if (!bullet.sprites[b])
          {
            bullet.sprites[b] = Sprite(bullet.image.Scale(8, 8));
            bullet.sprites[b].SetPosition(entry.x + 22 + b * 14, entry.y + entry.image.GetHeight() / 2 - 4, 10002);
          }
        bullet.sprites[b].SetOpacity(1);
      }
  }
Plymouth.SetDisplayNormalFunction (display_normal_callback);
Plymouth.SetDisplayPasswordFunction (display_password_callback);

msg = Sprite();
msg.SetPosition(12, 12, 10000);
fun display_message_callback (text) { msg.SetImage(Image.Text(text, 0.55, 0.53, 0.48)); }
fun hide_message_callback (text) { msg.SetOpacity(0); }
Plymouth.SetDisplayMessageFunction (display_message_callback);
Plymouth.SetHideMessageFunction (hide_message_callback);
