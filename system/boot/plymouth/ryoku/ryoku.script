# Ryoku Plymouth splash.
#
# A crisp logo reveal: the 力 seal blooms, dissolves on an ink wipe, and the
# RYOKU wordmark resolves. The frames in frames/ are transparent sprites;
# Plymouth paints the near-black background itself, so the logo composites sharp
# and is only ever downscaled to the panel, never upscaled (so never blurred).

# near-black (#060607): the same colour the Limine menu and the shell paper use,
# so every boot handoff is one flat colour with no flash between stages.
Window.SetBackgroundTopColor(0.0235, 0.0235, 0.0275);
Window.SetBackgroundBottomColor(0.0235, 0.0235, 0.0275);

global.num_frames = 48;

sw = Window.GetWidth();
sh = Window.GetHeight();

# Preload and pre-scale every frame once, at load. Fit to a fraction of the
# screen, capped at 1.0, so a small panel shrinks the logo and a 4K panel never
# stretches it: downscale-only keeps the mark razor-sharp on any resolution.
index = 0;
while (index < global.num_frames)
  {
    img = Image("frames/frame-" + index + ".png");
    if (index == 0)
      {
        mw = img.GetWidth();
        mh = img.GetHeight();
        scale = sh * 0.42 / mh;
        if (sw * 0.60 / mw < scale)
          scale = sw * 0.60 / mw;
        if (scale > 1)
          scale = 1;
        global.fw = mw * scale;
        global.fh = mh * scale;
      }
    anim[index] = img.Scale(global.fw, global.fh);
    index++;
  }

logo.sprite = Sprite();
logo.sprite.SetImage(anim[0]);
logo.sprite.SetX(sw / 2 - global.fw / 2);
logo.sprite.SetY(sh / 2 - global.fh / 2);
logo.sprite.SetOpacity(1);

global.fake_progress_limit = 0.7;
global.fake_progress_duration = 15.0;
global.fake_progress = 0.0;
global.real_progress = 0.0;
global.fake_progress_active = 0;
global.tick = 0;
global.password_shown = 0;
global.max_progress = 0.0;
global.frame = 0;

fun refresh_callback ()
  {
    # Play the reveal once, then hold on the RYOKU wordmark for the rest of boot.
    if (global.frame < global.num_frames - 1)
      global.frame++;
    logo.sprite.SetImage(anim[global.frame]);

    global.tick++;
    if (global.fake_progress_active == 1)
      {
        elapsed = global.tick / 50.0;
        ratio = elapsed / global.fake_progress_duration;
        if (ratio > 1.0)
          ratio = 1.0;
        eased = 1 - ((1 - ratio) * (1 - ratio));
        global.fake_progress = eased * global.fake_progress_limit;
        update_progress_bar(global.fake_progress);
      }
  }

Plymouth.SetRefreshFunction (refresh_callback);

# ---------------- progress bar ----------------

fun update_progress_bar(progress)
  {
    if (progress > global.max_progress)
      {
        global.max_progress = progress;
        width = Math.Int(progress_bar.original_image.GetWidth() * progress);
        if (width < 1)
          width = 1;
        progress_bar.image = progress_bar.original_image.Scale(width, progress_bar.original_image.GetHeight());
        progress_bar.sprite.SetImage(progress_bar.image);
      }
  }

fun show_progress_bar () { progress_box.sprite.SetOpacity(1); progress_bar.sprite.SetOpacity(1); }
fun hide_progress_bar () { progress_box.sprite.SetOpacity(0); progress_bar.sprite.SetOpacity(0); }

fun start_fake_progress ()
  {
    if (global.max_progress == 0.0)
      {
        global.fake_progress = 0.0;
        global.real_progress = 0.0;
        update_progress_bar(0.0);
      }
    global.fake_progress_active = 1;
    global.tick = 0;
  }

fun stop_fake_progress () { global.fake_progress_active = 0; }

# ---------------- password dialog ----------------

lock.image = Image("lock.png");
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");

entry.sprite = Sprite(entry.image);
entry.x = Window.GetWidth() / 2 - entry.image.GetWidth() / 2;
entry.y = logo.sprite.GetY() + global.fh + 48;
entry.sprite.SetPosition(entry.x, entry.y, 10001);
entry.sprite.SetOpacity(0);

lock_height = entry.image.GetHeight() * 0.8;
lock_scale = lock_height / 96;
lock_width = 84 * lock_scale;
scaled_lock = lock.image.Scale(lock_width, lock_height);
lock.sprite = Sprite(scaled_lock);
lock.x = entry.x - lock_width - 16;
lock.y = entry.y + entry.image.GetHeight() / 2 - lock_height / 2;
lock.sprite.SetPosition(lock.x, lock.y, 10001);
lock.sprite.SetOpacity(0);

bullet.sprites = [];

fun show_password_dialog () { lock.sprite.SetOpacity(1); entry.sprite.SetOpacity(1); }

fun hide_password_dialog ()
  {
    lock.sprite.SetOpacity(0);
    entry.sprite.SetOpacity(0);
    for (i = 0; bullet.sprites[i]; i++)
      bullet.sprites[i].SetOpacity(0);
  }

fun display_normal_callback ()
  {
    hide_password_dialog();
    mode = Plymouth.GetMode();
    if ((mode == "boot" || mode == "resume") && global.password_shown == 1)
      {
        show_progress_bar();
        start_fake_progress();
      }
  }

fun display_password_callback (prompt, bullets)
  {
    global.password_shown = 1;
    stop_fake_progress();
    hide_progress_bar();
    global.max_progress = 0.0;
    global.fake_progress = 0.0;
    global.real_progress = 0.0;
    show_password_dialog();

    for (i = 0; bullet.sprites[i]; i++)
      bullet.sprites[i].SetOpacity(0);

    max_bullets = 21;
    shown = bullets;
    if (shown > max_bullets)
      shown = max_bullets;

    for (i = 0; i < shown; i++)
      {
        if (!bullet.sprites[i])
          {
            scaled_bullet = bullet.image.Scale(8, 8);
            bullet.sprites[i] = Sprite(scaled_bullet);
            bx = entry.x + 22 + i * (8 + 6);
            by = entry.y + entry.image.GetHeight() / 2 - 4;
            bullet.sprites[i].SetPosition(bx, by, 10002);
          }
        bullet.sprites[i].SetOpacity(1);
      }
  }

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

progress_box.image = Image("progress_box.png");
progress_box.sprite = Sprite(progress_box.image);
progress_box.x = Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2;
progress_box.y = entry.y + entry.image.GetHeight() + 28;
progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 0);
progress_box.sprite.SetOpacity(0);

progress_bar.original_image = Image("progress_bar.png");
progress_bar.sprite = Sprite();
progress_bar.image = progress_bar.original_image.Scale(1, progress_bar.original_image.GetHeight());
progress_bar.x = Window.GetWidth() / 2 - progress_bar.original_image.GetWidth() / 2;
progress_bar.y = progress_box.y + (progress_box.image.GetHeight() - progress_bar.original_image.GetHeight()) / 2;
progress_bar.sprite.SetPosition(progress_bar.x, progress_bar.y, 1);
progress_bar.sprite.SetOpacity(0);

fun progress_callback (duration, progress)
  {
    global.real_progress = progress;
    if (progress > global.fake_progress_limit)
      {
        stop_fake_progress();
        update_progress_bar(progress);
      }
  }

Plymouth.SetBootProgressFunction(progress_callback);

fun quit_callback () { logo.sprite.SetOpacity(1); }
Plymouth.SetQuitFunction(quit_callback);

message_sprite = Sprite();
message_sprite.SetPosition(12, 12, 10000);

fun display_message_callback (text) { message_sprite.SetImage(Image.Text(text, 0.55, 0.53, 0.48)); }
fun hide_message_callback (text) { message_sprite.SetOpacity(0); }

Plymouth.SetDisplayMessageFunction (display_message_callback);
Plymouth.SetHideMessageFunction (hide_message_callback);
