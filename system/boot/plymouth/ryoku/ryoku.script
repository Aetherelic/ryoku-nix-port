praw[59] = Image("petals/petal-59.png");
global.PETN = 60;
p = 0;
while (p < global.PETN)
  {
    panim[p] = praw[p].Scale(sw, sh);
    p++;
  }
petSprite = Sprite();
petSprite.SetImage(panim[0]);
petSprite.SetPosition(0, 0, 0);

# ---- logo layer (centred, downscale-only, reveal then breathe) ----
