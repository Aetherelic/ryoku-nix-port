lraw[131] = Image("frames/frame-131.png");
lraw[132] = Image("frames/frame-132.png");
global.LOGN = 133;
mw = lraw[0].GetWidth();
mh = lraw[0].GetHeight();
scale = sh * 0.42 / mh;
if (sw * 0.60 / mw < scale)
  scale = sw * 0.60 / mw;
if (scale > 1)
  scale = 1;
global.fw = mw * scale;
global.fh = mh * scale;
i = 0;
while (i < global.LOGN)
  {
    lanim[i] = lraw[i].Scale(global.fw, global.fh);
    i++;
  }
logo.y = sh / 2 - global.fh / 2;
logoSprite = Sprite();
logoSprite.SetImage(lanim[0]);
logoSprite.SetPosition(sw / 2 - global.fw / 2, logo.y, 1);

global.lf = 0;
global.step = 0;
global.intro = 0;
global.active = 0;
global.tick = 0;
global.shown = 0;
global.prompt = 0;
global.maxp = 0.0;

# hold the 力 while the disk is locked, morph to RYOKU once unlocking begins.
fun refresh_callback ()
  {
    if (global.prompt == 1)
      global.lf = 0;
    else
      {
        if (global.intro < 30)
          global.intro++;
        else
          {
            global.step++;
            if (global.step >= 2)
              {
                global.step = 0;
                if (global.lf < global.LOGN - 1)
                  global.lf++;
              }
          }
      }
    logoSprite.SetImage(lanim[global.lf]);

    global.tick++;
    if (global.active == 1)
      {
        elapsed = global.tick / 50.0;
        ratio = elapsed / 15.0;
        if (ratio > 1.0)
          ratio = 1.0;
        eased = 1 - ((1 - ratio) * (1 - ratio));
        update_bar(eased * 0.7);
      }
  }
Plymouth.SetRefreshFunction (refresh_callback);

# ---- progress bar ----
fun update_bar (v)
  {
    if (v > global.maxp)
      {
        global.maxp = v;
        w = Math.Int(bar.orig.GetWidth() * v);
        if (w < 1)
          w = 1;
        bar.sprite.SetImage(bar.orig.Scale(w, bar.orig.GetHeight()));
      }
  }
fun show_bar () { box.sprite.SetOpacity(1); bar.sprite.SetOpacity(1); }
fun hide_bar () { box.sprite.SetOpacity(0); bar.sprite.SetOpacity(0); }

# ---- password dialog ----
lock.image = Image("lock.png");
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");

entry.sprite = Sprite(entry.image);
entry.x = sw / 2 - entry.image.GetWidth() / 2;
entry.y = logo.y + global.fh + 48;
entry.sprite.SetPosition(entry.x, entry.y, 10001);
entry.sprite.SetOpacity(0);

lh = entry.image.GetHeight() * 0.8;
lw = 84 * (lh / 96);
lock.sprite = Sprite(lock.image.Scale(lw, lh));
lock.sprite.SetPosition(entry.x - lw - 16, entry.y + entry.image.GetHeight() / 2 - lh / 2, 10001);
lock.sprite.SetOpacity(0);

bullet.sprites = [];

fun show_dialog () { lock.sprite.SetOpacity(1); entry.sprite.SetOpacity(1); }
fun hide_dialog ()
  {
    lock.sprite.SetOpacity(0);
    entry.sprite.SetOpacity(0);
    for (b = 0; bullet.sprites[b]; b++)
      bullet.sprites[b].SetOpacity(0);
  }

fun display_normal_callback ()
  {
    hide_dialog();
    global.prompt = 0;
    mode = Plymouth.GetMode();
    if ((mode == "boot" || mode == "resume") && global.shown == 1)
      {
        show_bar();
        global.active = 1;
        global.tick = 0;
      }
  }

fun display_password_callback (prompt, bullets)
  {
    global.shown = 1;
    global.prompt = 1;
    global.active = 0;
    hide_bar();
    global.maxp = 0.0;
    show_dialog();
    for (b = 0; bullet.sprites[b]; b++)
      bullet.sprites[b].SetOpacity(0);
    n = bullets;
    if (n > 21)
      n = 21;
    for (b = 0; b < n; b++)
      {
        if (!bullet.sprites[b])
          {
            bullet.sprites[b] = Sprite(bullet.image.Scale(8, 8));
            bullet.sprites[b].SetPosition(entry.x + 22 + b * 14, entry.y + entry.image.GetHeight() / 2 - 4, 10002);
          }
        bullet.sprites[b].SetOpacity(1);
      }
  }

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

box.image = Image("progress_box.png");
box.sprite = Sprite(box.image);
box.x = sw / 2 - box.image.GetWidth() / 2;
box.y = entry.y + entry.image.GetHeight() + 28;
box.sprite.SetPosition(box.x, box.y, 5);
box.sprite.SetOpacity(0);

bar.orig = Image("progress_bar.png");
bar.sprite = Sprite();
bar.sprite.SetImage(bar.orig.Scale(1, bar.orig.GetHeight()));
bar.sprite.SetPosition(sw / 2 - bar.orig.GetWidth() / 2, box.y + (box.image.GetHeight() - bar.orig.GetHeight()) / 2, 6);
bar.sprite.SetOpacity(0);

fun progress_callback (duration, progress)
  {
    if (progress > 0.7)
      {
        global.active = 0;
        update_bar(progress);
      }
  }
Plymouth.SetBootProgressFunction(progress_callback);

# snap to the finished wordmark at handoff so the desktop appears under RYOKU.
fun quit_callback () { logoSprite.SetImage(lanim[global.LOGN - 1]); logoSprite.SetOpacity(1); }
Plymouth.SetQuitFunction(quit_callback);

msg = Sprite();
msg.SetPosition(12, 12, 10000);
fun display_message_callback (text) { msg.SetImage(Image.Text(text, 0.55, 0.53, 0.48)); }
fun hide_message_callback (text) { msg.SetOpacity(0); }
Plymouth.SetDisplayMessageFunction (display_message_callback);
Plymouth.SetHideMessageFunction (hide_message_callback);
