# Ryoku Plymouth splash.
#
# Two layers: a full-screen sakura field that loops the whole time the system
# boots, and a crisp centred logo that reveals (seal -> RYOKU) once, then breathes
# so it never looks frozen. Plymouth paints the near-black background; the petal
# layer is stretched to the panel (soft petals, fine) while the logo layer is only
# downscaled (never upscaled), so the mark stays sharp on any resolution.

Window.SetBackgroundTopColor(0.0235, 0.0235, 0.0275);
Window.SetBackgroundBottomColor(0.0235, 0.0235, 0.0275);

sw = Window.GetWidth();
sh = Window.GetHeight();

# ---- sakura layer (full screen, seamless loop) ----
