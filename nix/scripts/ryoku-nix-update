set -euo pipefail

flake_root="${RYOKU_NIX_FLAKE:-/etc/nixos}"
input="${RYOKU_NIX_INPUT:-ryoku}"
installed="${RYOKU_NIX_VERSION:-}"

lock="$flake_root/flake.lock"

die() {
    printf 'ryoku-nix-update: %s\n' "$*" >&2
    return 1
}

trim_version() {
    sed -n '1{s/\r$//;p;}'
}

version_is_newer() {
    old="$1"
    new="$2"

    [ -n "$old" ] || return 1
    [ -n "$new" ] || return 1
    [ "$old" != "$new" ] || return 1

    first="$(
        printf '%s\n%s\n' "$old" "$new" |
            sort -V |
            head -n 1
    )"

    [ "$first" = "$old" ]
}

github_slug_from_remote() {
    remote="$1"

    case "$remote" in
        https://github.com/*)
            slug="${remote#https://github.com/}"
            ;;
        git@github.com:*)
            slug="${remote#git@github.com:}"
            ;;
        ssh://git@github.com/*)
            slug="${remote#ssh://git@github.com/}"
            ;;
        *)
            return 1
            ;;
    esac

    slug="${slug%.git}"

    case "$slug" in
        */*)
            printf '%s\n' "$slug"
            ;;
        *)
            return 1
            ;;
    esac
}

fetch_github_version() {
    slug="$1"
    ref="$2"

    curl \
        --fail \
        --silent \
        --show-error \
        --location \
        --max-time 20 \
        "https://raw.githubusercontent.com/$slug/$ref/VERSION" \
        2>/dev/null |
        trim_version
}

input_node() {
    jq -r \
        --arg input "$input" \
        '
            .nodes.root.inputs[$input] as $value
            | if ($value | type) == "string" then
                $value
              elif ($value | type) == "array" then
                $value[-1]
              else
                empty
              end
        ' \
        "$lock"
}

source_type=""
source_ref=""
source_path=""
channel="nix"
latest="$installed"
can_update=false

load_source() {
    [ -f "$lock" ] ||
        die "no flake.lock found at $lock"

    node="$(input_node)"

    [ -n "$node" ] ||
        die "flake input '$input' is not present in $lock"

    original="$(
        jq -c \
            --arg node "$node" \
            '.nodes[$node].original // {}' \
            "$lock"
    )"

    source_type="$(
        jq -r '.type // empty' <<< "$original"
    )"

    case "$source_type" in
        github)
            owner="$(jq -r '.owner // empty' <<< "$original")"
            repo="$(jq -r '.repo // empty' <<< "$original")"
            ref="$(jq -r '.ref // "HEAD"' <<< "$original")"

            [ -n "$owner" ] && [ -n "$repo" ] ||
                die "GitHub Ryoku input is missing owner/repo metadata"

            slug="$owner/$repo"
            channel="$ref"
            source_ref="github:$slug"

            if [ "$ref" != "HEAD" ]; then
                source_ref="$source_ref/$ref"
            fi

            can_update=true

            remote_version="$(
                fetch_github_version "$slug" "$ref" || true
            )"

            if [ -n "$remote_version" ]; then
                latest="$remote_version"
            fi
            ;;

        path)
            source_path="$(
                jq -r '.path // empty' <<< "$original"
            )"

            [ -n "$source_path" ] ||
                die "local Ryoku input has no path"

            case "$source_path" in
                /*)
                    ;;
                *)
                    source_path="$(
                        readlink -f "$flake_root/$source_path"
                    )"
                    ;;
            esac

            source_ref="path:$source_path"
            channel="local"
            can_update=false

            if [ -f "$source_path/VERSION" ]; then
                local_version="$(
                    trim_version < "$source_path/VERSION"
                )"

                if [ -n "$local_version" ]; then
                    latest="$local_version"
                fi
            fi

            if git -C "$source_path" rev-parse --git-dir \
                >/dev/null 2>&1
            then
                branch="$(
                    git -C "$source_path" branch --show-current \
                        2>/dev/null || true
                )"

                remote="$(
                    git -C "$source_path" remote get-url origin \
                        2>/dev/null || true
                )"

                slug="$(
                    github_slug_from_remote "$remote" 2>/dev/null || true
                )"

                if [ -n "$branch" ]; then
                    channel="$branch"
                fi

                if [ -n "$slug" ] && [ -n "$branch" ]; then
                    source_ref="github:$slug/$branch"

                    remote_version="$(
                        fetch_github_version "$slug" "$branch" || true
                    )"

                    if [ -n "$remote_version" ]; then
                        latest="$remote_version"
                    fi
                fi
            fi
            ;;

        *)
            source_ref="$source_type"
            channel="nix"
            can_update=false
            ;;
    esac
}

status_json() {
    load_source

    available=false
    pending=0
    updates='[]'
    recent='[]'

    if version_is_newer "$installed" "$latest"; then
        available=true
        pending=1

        updates="$(
            jq -cn \
                --arg old "$installed" \
                --arg new "$latest" \
                '[
                    {
                        name: "Ryoku for NixOS",
                        old: $old,
                        new: $new
                    }
                ]'
        )"
    else
        recent="$(
            jq -cn \
                --arg version "$installed" \
                '[
                    {
                        name: "Ryoku for NixOS",
                        old: "",
                        new: $version
                    }
                ]'
        )"
    fi

    jq -cn \
        --arg installedVersion "$installed" \
        --arg latestVersion "$latest" \
        --arg channel "$channel" \
        --arg source "$source_ref" \
        --argjson available "$available" \
        --argjson pendingUpdates "$pending" \
        --argjson canUpdate "$can_update" \
        --argjson updates "$updates" \
        --argjson recent "$recent" \
        '{
            installedVersion: $installedVersion,
            latestVersion: $latestVersion,
            available: $available,
            pendingUpdates: $pendingUpdates,
            updates: $updates,
            recent: $recent,
            channel: $channel,
            snapshots: 0,
            packages: [],
            backend: "nix",
            canUpdate: $canUpdate,
            source: $source
        }'
}

resolve_host() {
    if [ -n "${RYOKU_NIX_HOST:-}" ]; then
        printf '%s\n' "$RYOKU_NIX_HOST"
        return 0
    fi

    hosts_json="$(
        nix eval \
            --json \
            "${flake_root}#nixosConfigurations" \
            --apply builtins.attrNames
    )"

    mapfile -t hosts < <(
        jq -r '.[]' <<< "$hosts_json"
    )

    [ "${#hosts[@]}" -gt 0 ] ||
        die "no nixosConfigurations found in $flake_root"

    if [ "${#hosts[@]}" -eq 1 ]; then
        printf '%s\n' "${hosts[0]}"
        return 0
    fi

    current_host="$(hostname)"

    for candidate in "${hosts[@]}"; do
        configured="$(
            nix eval \
                --raw \
                "${flake_root}#nixosConfigurations.${candidate}.config.networking.hostName" \
                2>/dev/null || true
        )"

        if [ "$configured" = "$current_host" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    die "could not determine the active NixOS host"
}

update_nix() {
    load_source

    if [ "$source_type" = "path" ]; then
        cat >&2 <<MSG
ryoku-nix-update: this system uses a local Ryoku flake path:

  $source_path

The Hub will track that Nix port's VERSION, but it will not mutate
a development checkout automatically.

Update the checkout intentionally, then rebuild the NixOS generation.
MSG
        return 1
    fi

    [ -n "$latest" ] ||
        die "could not resolve the latest Ryoku Nix version"

    if [ "$installed" = "$latest" ]; then
        printf 'Ryoku for NixOS is already %s.\n' "$installed"
        return 0
    fi

    if ! version_is_newer "$installed" "$latest"; then
        die "refusing to move from $installed to non-newer version $latest"
    fi

    host="$(resolve_host)"

    backup="$(mktemp)"
    cp "$lock" "$backup"

    restore_lock=true

    cleanup() {
        if [ "$restore_lock" = true ]; then
            printf 'Restoring the previous Ryoku flake lock.\n' >&2
            sudo cp "$backup" "$lock" || true
        fi

        rm -f "$backup"
    }

    trap cleanup EXIT INT TERM

    printf 'Ryoku for NixOS: %s -> %s\n' \
        "$installed" \
        "$latest"

    printf 'Updating flake input: %s\n' "$input"

    sudo nix flake update \
        "$input" \
        --flake "$flake_root"

    printf 'Building NixOS configuration: %s\n' "$host"

    sudo nix build \
        "${flake_root}#nixosConfigurations.${host}.config.system.build.toplevel" \
        --no-link

    printf 'Switching to the new NixOS generation.\n'

    sudo nixos-rebuild switch \
        --flake "${flake_root}#${host}"

    restore_lock=false
    rm -f "$backup"
    trap - EXIT INT TERM

    printf 'Ryoku for NixOS update complete.\n'
}

case "${1:-status}" in
    status)
        status_json
        ;;
    update)
        update_nix
        ;;
    *)
        die "usage: ryoku-nix-update {status|update}"
        ;;
esac
